{
  "canonicalOrigin": "https://www.lifeeducation.org",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lifeeducation.org"
        }
      ],
      "destination": "https://www.lifeeducation.org/",
      "permanent": true,
      "note": "Canonicalize the apex homepage, which differs from the wildcard path matcher."
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lifeeducation.org"
        }
      ],
      "destination": "https://www.lifeeducation.org/:path*",
      "permanent": true,
      "note": "Canonicalize the bare domain to www."
    }
  ]
}
