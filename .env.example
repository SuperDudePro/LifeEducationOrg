# Server-side only. Never prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_ASK_MODEL=gpt-5.6-sol
# Optional site-wide daily ceilings (defaults 300 model calls, 200 question-record emails).
ASK_DAILY_MODEL_LIMIT=
ASK_DAILY_RECORD_LIMIT=

# Ask escalation uses these first, then falls back to CONTACT_FROM_EMAIL / CONTACT_TO_EMAIL.
ASK_FROM_EMAIL=
ASK_TO_EMAIL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
