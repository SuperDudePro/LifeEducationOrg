{
  "name": "lifeeducation-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ask:corpus": "node scripts/build-ask-corpus.mjs",
    "build": "npm run validate:redirects && npm run ask:corpus && npm run sitemap && npm run deployment:marker && tsc -b && vite build && npm run generate:routes && npm run validate:site",
    "check": "npm run lint && npm run test:ask && npm run test:indexnow && npm run test:post-contract && npm run validate:post-contract && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:ask": "NODE_ENV=test node --test test/ask/*.test.mjs",
    "test:indexnow": "node --test test/indexnow-routing.test.mjs",
    "test:post-contract": "node --test test/post-contract.test.mjs",
    "validate:post-contract": "node scripts/validate-post-contract.mjs --enforce",
    "retrofit:next": "node scripts/retrofit-next.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "deployment:marker": "node scripts/write-deployment-marker.mjs",
    "generate:routes": "node scripts/generate-route-pages.mjs",
    "sync:redirects": "node scripts/sync-redirects.mjs",
    "validate:redirects": "node scripts/validate-redirects.mjs",
    "validate:site": "node scripts/validate-site.mjs"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
